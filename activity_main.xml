<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
    <LinearLayout android:id="@+id/setupPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="46dp" android:background="#101827">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Offline USB Signage Browser" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
        <EditText android:id="@+id/serverInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:hint="Server URL, for example http://10.x.x.x:3000" android:inputType="textUri" android:singleLine="true" android:padding="12dp" android:background="#FFFFFF" android:textColor="#111827" />
        <EditText android:id="@+id/tokenInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Client token" android:inputType="text" android:singleLine="true" android:padding="12dp" android:background="#FFFFFF" android:textColor="#111827" />
        <Button android:id="@+id/chooseStorageButton" android:layout_width="280dp" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Select USB Storage Folder" />
        <TextView android:id="@+id/storageText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No USB folder selected" android:textColor="#CBD5E1" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
            <Button android:id="@+id/saveButton" android:layout_width="220dp" android:layout_height="wrap_content" android:text="Save and Start" />
            <Button android:id="@+id/syncButton" android:layout_width="180dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Sync Now" />
        </LinearLayout>
        <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Select USB storage and enter server details" android:textColor="#94A3B8" />
    </LinearLayout>
    <Button android:id="@+id/setupButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:alpha="0.15" android:text="Setup" />
</FrameLayout>
